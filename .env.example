# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=
APP_TOKEN=change-me-generate-with-setup.ps1
DB_PATH=data/app.db

# LLM backend for subtitle enrichment: none | claude | local
LLM_BACKEND=none
# claude backend (optional; also used as teacher when enabled in ml/configs/teacher.yaml)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# local backend = llama-server (OpenAI-compatible) running the fine-tuned student model
LOCAL_LLM_URL=http://127.0.0.1:8081
LOCAL_LLM_MODEL=student-v1
LLM_DAILY_CAP=80
ENRICH_WORKERS=1

# Machine-translation fallback for subtitles when no model output exists: auto | deepl | gtx | none
#   deepl = DeepL API (free tier 500k chars/month, key ends with ":fx"), gtx = unofficial Google endpoint (best effort)
MT_PROVIDER=auto
DEEPL_API_KEY=

# Seconds between YouTube transcript requests (YouTube temporarily blocks bursty IPs)
TRANSCRIPT_SLEEP_MIN=20
TRANSCRIPT_SLEEP_MAX=40

# YouTube Data API v3 quota guard (units/day; hard stop)
QUOTA_DAILY_CAP=8000
# Country you watch from (videos region-blocked there are skipped)
REGION=DE
